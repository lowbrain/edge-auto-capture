# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# PyInstaller の生成 spec（build.ps1 のコマンドで再生成できる）
*.spec

# カバレッジ計測の生成物。pytest / mypy / ruff のキャッシュは各ツールが
# 自前の .gitignore を書くので、ここへは足さない（二重管理になる）。
.coverage
.coverage.*
htmlcov/

# 仮想環境
.venv/
venv/

# このツールの生成物（キャプチャ保存先・動作ログ）
output/
log.txt

# 開発時にカレントディレクトリへ自己修復で生成される実設定（#101）。
# 出所は src/edge_auto_capture/default_config.ini（package-data）1 つだけで、
# ここへ生成されるのはその写し。追跡すると二重管理へ逆戻りする。
# .invalid は破損時の退避ファイル（config.py の _recover_broken_config）。
/config.ini
/config.ini.invalid

# Claude Code
# ローカル設定（settings.local.json）と作業用ワークツリーは追跡しないが、
# スキル定義（.claude/skills/）はリポジトリの資産なので追跡する。
# ディレクトリごと除外（.claude/）にすると git が中へ降りず否定パターンが効かないため
# `.claude/*` と書くこと。
.claude/*
!.claude/skills/
